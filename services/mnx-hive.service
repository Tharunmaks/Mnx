# Runs the Mnx Hive gateway 24/7 and restarts it after a crash or reboot.
# Install (edit User and paths first):
#   sudo cp services/mnx-hive.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mnx-hive
#   journalctl -u mnx-hive -f        # logs (the access token is printed here)
[Unit]
Description=Mnx Hive gateway
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=ubuntu
# Needed for Docker Cells: add the user to the docker group (sudo usermod -aG docker ubuntu)
WorkingDirectory=/home/ubuntu/Mnx
Environment=MNX_CELL_MODE=auto
ExecStart=/home/ubuntu/Mnx/.venv/bin/uvicorn gateway.api:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
